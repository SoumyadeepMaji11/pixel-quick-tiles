<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to change ringer mode (Android requires Notification Policy access) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Standard permission to adjust audio streams and ringer -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Permission to modify system settings (VIBRATE_WHEN_RINGING, HAPTIC_FEEDBACK_ENABLED) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Tactile vibration feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Request exemption from battery optimization so tiles survive app close -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional permission for master accessibility switch via ADB -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuickTiles">

        <!-- Activity accessible from Settings -> Apps -> Pixel Quick Tiles -> Additional settings -->
        <!-- No LAUNCHER category, so it does NOT appear in the phone's app drawer/home screen menu -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile 1: Ringer Mode Toggle (Normal <-> Vibration) -->
        <service
            android:name=".RingerModeTileService"
            android:exported="true"
            android:stopWithTask="false"
            android:icon="@drawable/ic_sound_normal"
            android:label="@string/tile_ringer_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile 2: Global Vibration Toggle -->
        <service
            android:name=".VibrationTileService"
            android:exported="true"
            android:stopWithTask="false"
            android:icon="@drawable/ic_vibration_on"
            android:label="@string/tile_vibration_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
